# Groq LLM API — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase Postgres connection string (pgvector extension enabled)
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, "Session" mode)
# Use the asyncpg-compatible form, e.g.:
# postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# Redis connection string
# Local Docker: redis://localhost:6379/0
# Hosted (e.g. Upstash): rediss://default:<password>@<host>:<port>
REDIS_URL=

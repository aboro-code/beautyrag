# Groq LLM API — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase Postgres connection string (pgvector extension enabled)
# Use the connection *pooler* string (Supabase dashboard -> Connect -> "Direct" tab ->
# Transaction/Session pooler), not the direct db.<ref>.supabase.co host -- that one
# often resolves IPv6-only, which most free hosting platforms can't reach. asyncpg
# needs statement_cache_size=0 with the pooler (already set in app/db.py) since it
# doesn't support server-side prepared statement caching across pooled connections.
# postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Redis connection string
# Local Docker: redis://localhost:6379/0
# Hosted (e.g. Upstash): rediss://default:<password>@<host>:<port>
REDIS_URL=
